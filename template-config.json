    "220def3f-6f70-4b68-b26c-f3a237b48c83": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "name": "Postgres",
      "build": {},
      "deploy": {
        "startCommand": "docker-entrypoint.sh postgres -c max_locks_per_transaction=512 -c pgroonga.enable_wal_resource_manager=on -c shared_preload_libraries=pgroonga_wal_resource_manager,pg_stat_statements",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/embeddedllm/jamaibase/postgres:20250305"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "22c86463-20d4-444f-96a4-e2fdf4c955b2": {
          "mountPath": "/var/lib/postgresql/data"
        }
      },
      "variables": {
        "POSTGRES_USER": {
          "defaultValue": "owlpguser",
          "description": "Postgres user",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated Postgres password",
          "isOptional": false
        },
        "POSTGRES_DB": {
          "defaultValue": "jamaibase_owl",
          "description": "Postgres database",
          "isOptional": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Data directory inside the volume",
          "isOptional": false
        }
      }
    },
    "4f434cdc-3a26-4506-8c20-731406509e8d": {
      "icon": "https://devicons.railway.app/i/redis.svg",
      "name": "Redis",
      "build": {},
      "deploy": {
        "startCommand": "/bin/sh -c \"chown -R redis:redis /data && exec docker-entrypoint.sh redis-server --appendonly yes --protected-mode no\"",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "redis:8.10.2-alpine"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "c963408f-1428-4a43-bbee-74dbe2323fef": {
          "mountPath": "/data"
        }
      },
      "variables": {}
    },
