{
  "services": {
    "ac6e0d70-bb16-4468-a847-17c12202d29a": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/jamaibase/main/icon.png",
      "name": "Gateway",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/healthz",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/two-workspaces/jamaibase",
        "rootDirectory": "/gateway"
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {},
      "variables": {
        "PORT": {
          "defaultValue": "8080",
          "description": "Port Caddy listens on - leave as is",
          "isOptional": false
        },
        "JAMAI_USERNAME": {
          "defaultValue": "admin",
          "description": "Username for the JamAI Base UI",
          "isOptional": false
        },
        "JAMAI_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Password for the JamAI Base UI. JamAI Base OSS has no login of its own; this gate is what keeps strangers out",
          "isOptional": false
        },
        "JAMAI_API_TOKEN": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Bearer token for the API and SDKs (Authorization: Bearer <token>)",
          "isOptional": false
        },
        "OWL_HOST": {
          "defaultValue": "${{Owl.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Owl API on the private network",
          "isOptional": false
        },
        "FRONTEND_HOST": {
          "defaultValue": "${{Frontend.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Frontend on the private network",
          "isOptional": false
        }
      }
    },
    "5d19ef3c-fc05-4936-84f9-15dab9cbe53b": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/jamaibase/main/icon.png",
      "name": "Frontend",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/two-workspaces/jamaibase",
        "rootDirectory": "/frontend"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {},
      "variables": {
        "PORT": {
          "defaultValue": "4000",
          "description": "Port the frontend listens on - leave as is",
          "isOptional": false
        },
        "FRONTEND_PORT": {
          "defaultValue": "4000",
          "description": "Must match PORT",
          "isOptional": false
        },
        "OWL_URL": {
          "defaultValue": "http://${{Owl.RAILWAY_PRIVATE_DOMAIN}}:6969",
          "description": "Owl API on the private network",
          "isOptional": false
        },
        "ORIGIN": {
          "defaultValue": "https://${{Gateway.RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of the app",
          "isOptional": false
        },
        "AUTH_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Session secret required by the frontend's auth library",
          "isOptional": false
        }
      }
    },
    "641abe9a-cd49-49c6-a22e-c3475a1fb8db": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/jamaibase/main/icon.png",
      "name": "Owl",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/api/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/two-workspaces/jamaibase",
        "rootDirectory": "/owl"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {},
      "variables": {
        "OWL_DB_PATH": {
          "defaultValue": "postgresql+psycopg://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}",
          "description": "Postgres connection (pgroonga + pgvectorscale)",
          "isOptional": false
        },
        "PGHOST": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Postgres host Owl waits for on boot",
          "isOptional": false
        },
        "OWL_REDIS_HOST": {
          "defaultValue": "${{Redis.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Redis for cache, locks and the Celery queue",
          "isOptional": false
        },
        "OWL_CLICKHOUSE_HOST": {
          "defaultValue": "${{ClickHouse.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "ClickHouse for usage meters",
          "isOptional": false
        },
        "OWL_CLICKHOUSE_USER": {
          "defaultValue": "${{ClickHouse.CLICKHOUSE_USER}}",
          "description": "ClickHouse user",
          "isOptional": false
        },
        "OWL_CLICKHOUSE_PASSWORD": {
          "defaultValue": "${{ClickHouse.CLICKHOUSE_PASSWORD}}",
          "description": "ClickHouse password",
          "isOptional": false
        },
        "OWL_CLICKHOUSE_DB": {
          "defaultValue": "${{ClickHouse.CLICKHOUSE_DB}}",
          "description": "ClickHouse database",
          "isOptional": false
        },
        "OWL_S3_ENDPOINT": {
          "defaultValue": "http://${{MinIO.RAILWAY_PRIVATE_DOMAIN}}:9000",
          "description": "MinIO on the private network",
          "isOptional": false
        },
        "OWL_S3_ACCESS_KEY_ID": {
          "defaultValue": "${{MinIO.MINIO_ROOT_USER}}",
          "description": "MinIO access key",
          "isOptional": false
        },
        "OWL_S3_SECRET_ACCESS_KEY": {
          "defaultValue": "${{MinIO.MINIO_ROOT_PASSWORD}}",
          "description": "MinIO secret key",
          "isOptional": false
        },
        "OWL_FILE_DIR": {
          "defaultValue": "s3://${{MinIO.MINIO_BUCKET}}",
          "description": "Bucket for uploaded files",
          "isOptional": false
        },
        "OWL_FILE_PROXY_URL": {
          "defaultValue": "${{Gateway.RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public host that signed file links point at",
          "isOptional": false
        },
        "OWL_GOTENBERG_URL": {
          "defaultValue": "http://${{Gotenberg.RAILWAY_PRIVATE_DOMAIN}}:3000",
          "description": "Gotenberg converts Office and HTML files to PDF",
          "isOptional": false
        },
        "OWL_CODE_EXECUTOR_ENDPOINT": {
          "defaultValue": "http://${{Kopi.RAILWAY_PRIVATE_DOMAIN}}:3000",
          "description": "Kopi runs Python code columns in a sandbox",
          "isOptional": false
        },
        "OWL_OPENTELEMETRY_HOST": {
          "defaultValue": "${{OTel.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "OpenTelemetry collector",
          "isOptional": false
        },
        "OWL_VLM_MODEL_ID": {
          "defaultValue": "openai/gpt-4o-mini",
          "description": "Vision model that reads PDFs and Office files for Knowledge Tables. Must match the ID of a chat model with image input you added under Models",
          "isOptional": false
        },
        "OWL_OPENAI_API_KEY": {
          "defaultValue": "",
          "description": "Optional: OpenAI key for the organization, set before first boot (you can add keys in the UI later)",
          "isOptional": true
        },
        "OWL_ANTHROPIC_API_KEY": {
          "defaultValue": "",
          "description": "Optional: Anthropic key, set before first boot",
          "isOptional": true
        },
        "OWL_GEMINI_API_KEY": {
          "defaultValue": "",
          "description": "Optional: Gemini key, set before first boot",
          "isOptional": true
        },
        "OWL_OPENROUTER_API_KEY": {
          "defaultValue": "",
          "description": "Optional: OpenRouter key, set before first boot",
          "isOptional": true
        },
        "PORT": {
          "defaultValue": "6969",
          "description": "Port Owl listens on - leave as is",
          "isOptional": false
        },
        "OWL_WORKERS": {
          "defaultValue": "1",
          "description": "API worker processes; each adds ~300 MB",
          "isOptional": false
        },
        "OWL_ENCRYPTION_KEY": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Encrypts provider keys and code-column secrets. Never change it after saving keys",
          "isOptional": false
        }
      }
    },
    "6120f202-ad47-46bb-8b3a-9ed60e8bda30": {
      "icon": "https://raw.githubusercontent.com/two-workspaces/jamaibase/main/icon.png",
      "name": "Starling",
      "build": {},
      "deploy": {
        "startCommand": "/bin/bash -c \"until curl -sf http://$OWL_API_HOST:6969/api/health >/dev/null; do echo Waiting for Owl; sleep 3; done; exec uv run --no-sync celery -A owl.entrypoints.starling worker --loglevel=warning --max-memory-per-child 1048576 --concurrency=2 --beat\"",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "repo": "https://github.com/two-workspaces/jamaibase",
