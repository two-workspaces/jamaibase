    "2fc89dc8-84c6-44ab-87bb-e6d671af2272": {
      "icon": "https://devicons.railway.app/i/minio.svg",
      "name": "MinIO",
      "build": {},
      "deploy": {
        "startCommand": "/bin/bash -c \"(until mc alias set local http://127.0.0.1:9000 $MINIO_ROOT_USER $MINIO_ROOT_PASSWORD >/dev/null 2>&1; do sleep 1; done; mc mb --ignore-existing local/$MINIO_BUCKET) & exec /usr/bin/docker-entrypoint.sh server /data --address :9000\"",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "pgsty/silo:RELEASE.2026-08-06T00-00-00Z"
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "48937c39-1489-4884-bee9-a4f183bb04c5": {
          "mountPath": "/data"
        }
      },
      "variables": {
        "MINIO_ROOT_USER": {
          "defaultValue": "jamai",
          "description": "MinIO access key",
          "isOptional": false
        },
        "MINIO_ROOT_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated MinIO secret key",
          "isOptional": false
        },
        "MINIO_BUCKET": {
          "defaultValue": "file",
          "description": "Bucket for uploaded files, created on boot",
          "isOptional": false
        }
      }
    },
